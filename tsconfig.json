{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "types": ["node", "vite/client"]
  },
  "include": ["platform", "waitlist", "api", "web", "tests", "keeper", "nft/*.ts", "vite.config.ts"]
}
